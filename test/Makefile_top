# Makefile_top -- full-engine test: ntt_top vs the Python golden model
SIM ?= icarus
TOPLEVEL_LANG ?= verilog
SRC_DIR = $(PWD)/../src
VERILOG_SOURCES = $(SRC_DIR)/mod_mult.v \
                  $(SRC_DIR)/mod_add.v \
                  $(SRC_DIR)/mod_sub.v \
                  $(SRC_DIR)/butterfly.v \
                  $(SRC_DIR)/twiddle_rom.v \
                  $(SRC_DIR)/coeff_mem.v \
                  $(SRC_DIR)/control_fsm.v \
                  $(SRC_DIR)/ntt_top.v

# Preload the coefficient array for simulation. On silicon this memory comes
# up undefined and is filled through the chip pins, so the $readmemh in
# coeff_mem.v is guarded and only these two defines switch it on.
COMPILE_ARGS += -DNTT_PRELOAD_COEFFS


TOPLEVEL = ntt_top
COCOTB_TEST_MODULES = test_ntt_top

include $(shell cocotb-config --makefiles)/Makefile.sim
